@@ -448,7 +448,7 @@ void mt7663s_w103d_txrx_worker_core(struct mt76_dev *dev)
 		if (!nframes && !mt7663s_w103d_txqs_empty(dev) &&
 		    tx_retries < W103D_TX_QUOTA_RETRY_MAX) {
