+/* Synchronize connected BSS and STA records to N9 in the gen4m order
+ * (CMD 0x12 BSS_INFO -> CMD 0x19 BSS_RLM -> CMD 0x13 STA_REC) so N9's
+ * internal rate control unlocks full channel width, NSS, and TX A-MPDU.
+ */
+static void
+mt7663s_w103d_sync_vendor_connect(struct mt7615_dev *dev,
+				  struct ieee80211_vif *vif)
+{
+	struct mt76_phy *mphy = &dev->mphy;
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct mt7663s_w103d_vendor_bss_info bss_req = {};
+	struct mt7663s_w103d_vendor_sta_record sta_req;
+	struct ieee80211_sta *sta;
+	enum nl80211_band band;
+	bool has_sta = false;
+	u8 sta_idx = 1;
+	u8 phy_type_set = 0;
+	int ret;
+
+	if (!vif->cfg.assoc || vif->type != NL80211_IFTYPE_STATION ||
+	    !mphy->chandef.chan)
+		return;
+
+	band = mphy->chandef.chan->band;
+
+	rcu_read_lock();
+	sta = ieee80211_find_sta(vif, vif->bss_conf.bssid);
+	if (sta) {
+		struct mt7615_sta *msta = (struct mt7615_sta *)sta->drv_priv;
+
+		sta_idx = msta->wcid.idx;
+		phy_type_set = (band == NL80211_BAND_5GHZ ? 0x08 : 0x03);
+		if (sta->deflink.ht_cap.ht_supported)
+			phy_type_set |= 0x10;
+		if (sta->deflink.vht_cap.vht_supported)
+			phy_type_set |= 0x20;
+		mt7663s_w103d_fill_vendor_sta_record(&dev->phy, vif, sta,
+						     &sta_req);
+		has_sta = true;
+	}
+	rcu_read_unlock();
+
+	bss_req.bss_idx = mvif->mt76.idx;
+	bss_req.conn_state = 0;
+	bss_req.op_mode = 1;
+	if (vif->cfg.ssid_len <= sizeof(bss_req.ssid)) {
+		bss_req.ssid_len = vif->cfg.ssid_len;
+		memcpy(bss_req.ssid, vif->cfg.ssid, vif->cfg.ssid_len);
+	}
+	memcpy(bss_req.bssid, vif->bss_conf.bssid, ETH_ALEN);
+	bss_req.is_qbss = vif->bss_conf.qos;
+	bss_req.basic_rate_set = cpu_to_le16(mt7663s_w103d_vendor_rate_set(
+		vif->bss_conf.basic_rates, band));
+	bss_req.op_rate_set = bss_req.basic_rate_set;
+	bss_req.sta_rec_idx_ap = sta_idx;
+	bss_req.non_ht_basic_phy_type = (band == NL80211_BAND_5GHZ ? 4 : 1);
+	bss_req.phy_type_set = phy_type_set;
+	bss_req.bmc_wlan_idx = mvif->sta.wcid.idx ? mvif->sta.wcid.idx : 1;
+	mt7663s_w103d_fill_bss_rlm(mphy, vif, &bss_req.rlm);
+	bss_req.dbdc_band = 4;
+	bss_req.wmm_set = mvif->mt76.wmm_idx;
+	bss_req.nss = max_t(u8, hweight8(mphy->antenna_mask), 1);
+
+	mt7615_mutex_acquire(dev);
+	ret = mt76_mcu_send_msg(&dev->mt76,
+				MCU_CMD_VENDOR_SET(MCU_CMD_VENDOR_UPDATE_BSS_INFO),
+				&bss_req, sizeof(bss_req), false);
+	dev_dbg(dev->mt76.dev,
+		"W103D: vendor BSS connect bss=%u sta=%u vht_w=%u seg1=%u nss=%u ret=%d\n",
+		bss_req.bss_idx, sta_idx, bss_req.rlm.vht_width,
+		bss_req.rlm.center_seg1, bss_req.nss, ret);
+
+	ret = mt7663s_w103d_sync_bss_rlm(dev, vif);
+	if (ret)
+		dev_warn(dev->mt76.dev,
+			 "W103D: failed to sync BSS channel: %d\n", ret);
+
+	if (has_sta)
+		mt7663s_w103d_send_vendor_sta_record(dev, &sta_req, false);
+	mt7615_mutex_release(dev);
+}
+
+static void mt7663s_w103d_scan_restore_work(struct work_struct *work)
+{
+	struct mt7663s_w103d_intr_state *state =
+		container_of(work, struct mt7663s_w103d_intr_state, scan_restore_work);
+	struct mt76_dev *mdev = state->mdev;
+	struct mt7615_dev *dev = container_of(mdev, struct mt7615_dev, mt76);
+	struct ieee80211_vif *vif = READ_ONCE(state->assoc_vif);
+
+	if (!vif || !vif->cfg.assoc || READ_ONCE(state->quota_stopping))
+		return;
+
+	if (dev->mphy.chandef.chan &&
+	    dev->mphy.chandef.chan->band == NL80211_BAND_5GHZ &&
+	    !xchg(&state->join_privilege_held, true)) {
+		mt7663s_w103d_channel_privilege(dev, &dev->mphy.chandef, true);
+		msleep(50);
+	}
+
+	if (READ_ONCE(state->bss_deactivated)) {
+		mt7615_mutex_acquire(dev);
+		mt7663s_w103d_vendor_bss_activate(dev, vif, true);
+		mt7615_mutex_release(dev);
+	}
+
+	mt7663s_w103d_sync_vendor_connect(dev, vif);
+	dev_dbg(mdev->dev, "W103D: restored connected BSS/STA after scan\n");
+}
