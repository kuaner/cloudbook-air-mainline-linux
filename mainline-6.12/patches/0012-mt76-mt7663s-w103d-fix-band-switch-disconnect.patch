+/* gen4m CMD_SET_BSS_INFO (CID 0x12, 116 bytes) matching wlan_mt7663_sdio.ko
+ * nicUpdateBss().  Used on disconnect to transition N9's internal BSS state
+ * back to PARAM_MEDIA_STATE_DISCONNECTED and clear stale RLM parameters.
+ */
+struct mt7663s_w103d_vendor_bss_info {
+	u8 bss_idx;
+	u8 conn_state;
+	u8 op_mode;
+	u8 ssid_len;
+	u8 ssid[32];
+	u8 bssid[ETH_ALEN];
+	u8 is_qbss;
+	u8 rsv1;
+	__le16 op_rate_set;
+	__le16 basic_rate_set;
+	u8 sta_rec_idx_ap;
+	u8 rsv2;
+	__le16 hw_default_fixed_rate;
+	u8 non_ht_basic_phy_type;
+	u8 auth_mode;
+	u8 enc_status;
+	u8 phy_type_set;
+	u8 wapi_mode;
+	u8 is_ap_mode;
+	u8 bmc_wlan_idx;
+	u8 hidden_ssid_mode;
+	u8 disconn_detect_th;
+	u8 rsv3[3];
+	__le32 private_data;
+	struct mt7663s_w103d_bss_rlm rlm;
+	u8 dbdc_band;
+	u8 wmm_set;
+	u8 dbdc_action;
+	u8 nss;
+	u8 rsv4[22];
+} __packed;
+
+static_assert(sizeof(struct mt7663s_w103d_vendor_bss_info) == 116);
+static_assert(offsetof(struct mt7663s_w103d_vendor_bss_info, rlm) == 0x44);
+static_assert(offsetof(struct mt7663s_w103d_vendor_bss_info, dbdc_band) == 0x5a);
+
+static int
+mt7663s_w103d_vendor_bss_activate_raw(struct mt7615_dev *dev, u8 bss_idx,
+				      u8 omac_idx, u8 bmc_wlan_idx,
+				      const u8 *mac, bool active)
+{
+	struct mt7663s_w103d_intr_state *state =
+		mt7663s_w103d_intr_state(&dev->mt76);
+	struct {
+		u8 bss_idx;
+		u8 active;
+		u8 net_type;
+		u8 omac_idx;
+		u8 bss_mac[ETH_ALEN];
+		u8 bmc_wlan_idx;
+		u8 rsv;
+	} __packed act = {
+		.bss_idx = bss_idx,
+		.active = active,
+		.net_type = 0,
+		.omac_idx = omac_idx,
+		.bmc_wlan_idx = bmc_wlan_idx ? bmc_wlan_idx : 1,
+	};
+	int ret;
+
+	if (active && mac)
+		memcpy(act.bss_mac, mac, ETH_ALEN);
+
+	ret = mt76_mcu_send_msg(&dev->mt76,
+				MCU_CMD_VENDOR_SET(MCU_CMD_VENDOR_BSS_ACTIVATE_CTRL),
+				&act, sizeof(act), false);
+	if (!ret && state) {
+		state->last_bss_idx = bss_idx;
+		state->last_omac_idx = omac_idx;
+		state->last_bmc_wlan_idx = act.bmc_wlan_idx;
+		if (mac)
+			memcpy(state->last_bss_mac, mac, ETH_ALEN);
+		WRITE_ONCE(state->bss_deactivated, !active);
+	}
+
+	return ret;
+}
+
+static int
+mt7663s_w103d_vendor_bss_activate(struct mt7615_dev *dev,
+				  struct ieee80211_vif *vif, bool active)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+
+	return mt7663s_w103d_vendor_bss_activate_raw(dev, mvif->mt76.idx,
+						     mvif->mt76.omac_idx,
+						     mvif->sta.wcid.idx,
+						     vif->addr, active);
+}
+
+static int mt7663s_w103d_channel_privilege(struct mt7615_dev *dev,
+					   struct cfg80211_chan_def *chandef,
+					   bool request);
+
+static void
+mt7663s_w103d_vendor_disconnect_bss(struct mt7615_dev *dev,
+				    struct ieee80211_vif *vif)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct mt7663s_w103d_intr_state *state =
+		mt7663s_w103d_intr_state(&dev->mt76);
+	struct mt7663s_w103d_vendor_bss_info req = {
+		.bss_idx = mvif->mt76.idx,
+		/* PARAM_MEDIA_STATE_DISCONNECTED in gen4m ABI */
+		.conn_state = 1,
+		.op_mode = 0,
+		/* STA_REC_INDEX_NOT_FOUND */
+		.sta_rec_idx_ap = 0xfe,
+		.bmc_wlan_idx = mvif->sta.wcid.idx ? mvif->sta.wcid.idx : 1,
+		.rlm = {
+			.bss_idx = mvif->mt76.idx,
+		},
+		/* ENUM_BAND_AUTO */
+		.dbdc_band = 4,
+		.wmm_set = mvif->mt76.wmm_idx,
+		.nss = max_t(u8, hweight8(dev->mphy.antenna_mask), 1),
+	};
+	int upd_ret, deact_ret;
+
+	if (state && xchg(&state->join_privilege_held, false))
+		mt7663s_w103d_channel_privilege(dev, &dev->mphy.chandef, false);
+
+	upd_ret = mt76_mcu_send_msg(&dev->mt76,
+				    MCU_CMD_VENDOR_SET(MCU_CMD_VENDOR_UPDATE_BSS_INFO),
+				    &req, sizeof(req), false);
+	deact_ret = mt7663s_w103d_vendor_bss_activate(dev, vif, false);
+
+	dev_info(dev->mt76.dev,
+		 "W103D: vendor BSS disconnect bss=%u update=%d deact=%d\n",
+		 mvif->mt76.idx, upd_ret, deact_ret);
+}
