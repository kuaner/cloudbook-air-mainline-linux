+static const struct ieee80211_iface_limit w103d_if_limits[] = {
+	{
+		.max = 1,
+		.types = BIT(NL80211_IFTYPE_ADHOC)
+	}, {
+		.max = MT7615_MAX_INTERFACES,
+		.types = BIT(NL80211_IFTYPE_AP) |
+#ifdef CONFIG_MAC80211_MESH
+			 BIT(NL80211_IFTYPE_MESH_POINT) |
+#endif
+			 BIT(NL80211_IFTYPE_STATION)
+	}
+};
+
+static const struct ieee80211_iface_combination w103d_if_comb[] = {
+	{
+		.limits = w103d_if_limits,
+		.n_limits = ARRAY_SIZE(w103d_if_limits),
+		.max_interfaces = MT7615_MAX_INTERFACES,
+		.num_different_channels = 1,
+		.beacon_int_infra_match = true,
+	}
+};
+
+void mt7663s_w103d_sanitize_wiphy(struct mt76_dev *mdev)
+{
+	struct wiphy *wiphy = mdev->hw->wiphy;
+
+	/* W103D N9 firmware wedges on sched_scan commands and lacks P2P
+	 * OMAC/ROC support; disable both so cfg80211/NetworkManager never
+	 * declare p2p-dev-* interfaces or issue sched_scan requests.
+	 */
+	wiphy->flags &= ~WIPHY_FLAG_HAS_REMAIN_ON_CHANNEL;
+	wiphy->features &= ~(NL80211_FEATURE_P2P_GO_CTWIN |
+			     NL80211_FEATURE_P2P_GO_OPPPS |
+			     NL80211_FEATURE_SCHED_SCAN_RANDOM_MAC_ADDR);
+	wiphy->max_remain_on_channel_duration = 0;
+
+	wiphy->max_sched_scan_plan_interval = 0;
+	wiphy->max_sched_scan_plan_iterations = 0;
+	wiphy->max_sched_scan_ie_len = 0;
+	wiphy->max_sched_scan_ssids = 0;
+	wiphy->max_match_sets = 0;
+	wiphy->max_sched_scan_reqs = 0;
+}
+
+int mt7663s_w103d_init_wiphy(struct mt76_dev *mdev)
+{
+	struct wiphy *wiphy = mdev->hw->wiphy;
+
+	wiphy->interface_modes &= ~(BIT(NL80211_IFTYPE_P2P_CLIENT) |
+				    BIT(NL80211_IFTYPE_P2P_GO) |
+				    BIT(NL80211_IFTYPE_P2P_DEVICE));
+	wiphy->iface_combinations = w103d_if_comb;
+	wiphy->n_iface_combinations = ARRAY_SIZE(w103d_if_comb);
+	mt7663s_w103d_sanitize_wiphy(mdev);
+
+	dev_info(mdev->dev,
+		 "W103D: disabled P2P interface modes and sched_scan\n");
+
+	return 0;
+}
