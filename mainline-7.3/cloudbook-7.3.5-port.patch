diff --git a/drivers/power/supply/sc2021_charger.c b/drivers/power/supply/sc2021_charger.c
new file mode 100644
index 000000000..a334bf5c0
--- /dev/null
+++ b/drivers/power/supply/sc2021_charger.c
@@ -0,0 +1,433 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Southchip SC2021 Type-C / USB PD / DPDM port controller driver
+ *
+ * Copyright (C) 2026 CloudBook Air Linux Port
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define SC2021_REG_TYPEC_STATE		0x10
+#define SC2021_TYPEC_ATTACHED_SNK	BIT(0)
+#define SC2021_TYPEC_ATTACHED_SRC	BIT(1)
+#define SC2021_TYPEC_POWER_GOOD		BIT(2)
+#define SC2021_TYPEC_ROLE_MASK		GENMASK(7, 6)
+
+#define SC2021_REG_DPDM_IN_STATE	0x11
+#define SC2021_DPDM_MCU_CTRL		BIT(6)
+#define SC2021_CHG_DET_READY		BIT(7)
+
+#define SC2021_REG_VBUS_EXT_MSB		0x12
+#define SC2021_REG_VBUS_EXT_LSB		0x13
+#define SC2021_REG_PD_IMAX		0x14
+#define SC2021_REG_PD_VMAX		0x15
+#define SC2021_REG_VBUS_ADC		0x16
+#define SC2021_REG_IBUS_ADC		0x17
+#define SC2021_REG_DPDM_VBUS_MSB	0x18
+#define SC2021_REG_DPDM_VBUS_LSB	0x19
+#define SC2021_REG_OTG_SUPPORT		0x1b
+#define SC2021_REG_FW_VERSION		0x1f
+
+#define SC2021_VBUS_STEP_UV		128000
+#define SC2021_IBUS_STEP_UA		32000
+#define SC2021_RETRY_DELAY_MS		600
+#define SC2021_MAX_DET_RETRIES		10
+
+struct sc2021_device {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+	struct gpio_desc *pdotg_gpio;
+	struct gpio_desc *dpdm_gpio;
+	struct delayed_work evt_work;
+	struct mutex lock;
+
+	char fw_ver[16];
+	u8 last_typec;
+	u8 last_dpdm;
+	u8 last_pd_vmax;
+	u8 last_pd_imax;
+	unsigned int retries;
+	bool state_valid;
+};
+
+static const struct regmap_config sc2021_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = SC2021_REG_FW_VERSION,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int sc2021_read_u8(struct sc2021_device *sc, unsigned int reg, u8 *val)
+{
+	unsigned int raw;
+	int ret;
+
+	ret = regmap_read(sc->regmap, reg, &raw);
+	if (ret)
+		return ret;
+
+	*val = raw & 0xff;
+	return 0;
+}
+
+static int sc2021_read_be16(struct sc2021_device *sc, unsigned int reg_msb,
+			    u16 *val)
+{
+	u8 buf[2];
+	int ret;
+
+	ret = regmap_bulk_read(sc->regmap, reg_msb, buf, sizeof(buf));
+	if (ret)
+		return ret;
+
+	*val = ((u16)buf[0] << 8) | buf[1];
+	return 0;
+}
+
+/**
+ * sc2021_sync_dpdm_mux() - Route DPDM/OTG GPIOs per controller state.
+ * @sc: SC2021 device instance.
+ * @dpdm_state: Cached value of SC2021_REG_DPDM_IN_STATE.
+ */
+static void sc2021_sync_dpdm_mux(struct sc2021_device *sc, u8 dpdm_state)
+{
+	/* Bit 6 clear delegates DPDM/OTG lines to SC2021; set delegates to EC. */
+	int mux_to_sc2021 = !(dpdm_state & SC2021_DPDM_MCU_CTRL);
+
+	gpiod_set_value_cansleep(sc->pdotg_gpio, mux_to_sc2021);
+	gpiod_set_value_cansleep(sc->dpdm_gpio, mux_to_sc2021);
+}
+
+static void sc2021_typec_evt_worker(struct work_struct *work)
+{
+	struct sc2021_device *sc =
+		container_of(work, struct sc2021_device, evt_work.work);
+	u8 typec = 0, dpdm = 0, pd_vmax = 0, pd_imax = 0;
+	bool changed = false;
+	int ret;
+
+	mutex_lock(&sc->lock);
+
+	ret = sc2021_read_u8(sc, SC2021_REG_TYPEC_STATE, &typec);
+	if (ret)
+		goto err_unlock;
+
+	ret = sc2021_read_u8(sc, SC2021_REG_DPDM_IN_STATE, &dpdm);
+	if (ret)
+		goto err_unlock;
+
+	sc2021_read_u8(sc, SC2021_REG_PD_VMAX, &pd_vmax);
+	sc2021_read_u8(sc, SC2021_REG_PD_IMAX, &pd_imax);
+
+	sc2021_sync_dpdm_mux(sc, dpdm);
+
+	if (!sc->state_valid || typec != sc->last_typec ||
+	    dpdm != sc->last_dpdm || pd_vmax != sc->last_pd_vmax ||
+	    pd_imax != sc->last_pd_imax) {
+		sc->last_typec = typec;
+		sc->last_dpdm = dpdm;
+		sc->last_pd_vmax = pd_vmax;
+		sc->last_pd_imax = pd_imax;
+		sc->state_valid = true;
+		changed = true;
+	}
+
+	if ((typec & SC2021_TYPEC_ATTACHED_SNK) &&
+	    !(dpdm & SC2021_CHG_DET_READY) &&
+	    sc->retries < SC2021_MAX_DET_RETRIES) {
+		sc->retries++;
+		schedule_delayed_work(&sc->evt_work,
+				      msecs_to_jiffies(SC2021_RETRY_DELAY_MS));
+	} else {
+		sc->retries = 0;
+	}
+
+	mutex_unlock(&sc->lock);
+
+	if (changed && sc->psy) {
+		dev_info(sc->dev,
+			 "typec=0x%02x dpdm=0x%02x pd=%umV/%umA\n",
+			 typec, dpdm,
+			 pd_vmax * (SC2021_VBUS_STEP_UV / 1000),
+			 pd_imax * (SC2021_IBUS_STEP_UA / 1000));
+		power_supply_changed(sc->psy);
+	}
+	return;
+
+err_unlock:
+	mutex_unlock(&sc->lock);
+	dev_err_ratelimited(sc->dev, "failed to read SC2021 event state: %d\n",
+			    ret);
+}
+
+static irqreturn_t sc2021_irq_handler(int irq, void *data)
+{
+	struct sc2021_device *sc = data;
+
+	mutex_lock(&sc->lock);
+	sc->retries = 0;
+	mutex_unlock(&sc->lock);
+
+	mod_delayed_work(system_wq, &sc->evt_work, msecs_to_jiffies(30));
+	return IRQ_HANDLED;
+}
+
+static enum power_supply_property sc2021_psy_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+};
+
+static int sc2021_psy_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct sc2021_device *sc = power_supply_get_drvdata(psy);
+	u8 v8 = 0, pd_vmax = 0;
+	u16 mv = 0;
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = sc2021_read_u8(sc, SC2021_REG_TYPEC_STATE, &v8);
+		if (ret)
+			return ret;
+		if (v8 & SC2021_TYPEC_ATTACHED_SNK)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (v8 & SC2021_TYPEC_ATTACHED_SRC)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = sc2021_read_u8(sc, SC2021_REG_TYPEC_STATE, &v8);
+		if (ret)
+			return ret;
+		val->intval = !!(v8 & SC2021_TYPEC_ATTACHED_SNK);
+		return 0;
+
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		ret = sc2021_read_u8(sc, SC2021_REG_TYPEC_STATE, &v8);
+		if (ret)
+			return ret;
+		if (!(v8 & SC2021_TYPEC_ATTACHED_SNK)) {
+			val->intval = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+			return 0;
+		}
+		ret = sc2021_read_u8(sc, SC2021_REG_PD_VMAX, &pd_vmax);
+		if (ret)
+			return ret;
+		if (pd_vmax * (SC2021_VBUS_STEP_UV / 1000) > 5500)
+			val->intval = POWER_SUPPLY_USB_TYPE_PD;
+		else
+			val->intval = POWER_SUPPLY_USB_TYPE_C;
+		return 0;
+
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX:
+		ret = sc2021_read_u8(sc, SC2021_REG_PD_VMAX, &v8);
+		if (ret)
+			return ret;
+		val->intval = (int)v8 * SC2021_VBUS_STEP_UV;
+		return 0;
+
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = sc2021_read_u8(sc, SC2021_REG_VBUS_ADC, &v8);
+		if (ret)
+			return ret;
+		if (v8) {
+			val->intval = (int)v8 * SC2021_VBUS_STEP_UV;
+			return 0;
+		}
+		ret = sc2021_read_be16(sc, SC2021_REG_VBUS_EXT_MSB, &mv);
+		if (ret)
+			return ret;
+		val->intval = (int)mv * 1000;
+		return 0;
+
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		ret = sc2021_read_u8(sc, SC2021_REG_PD_IMAX, &v8);
+		if (ret)
+			return ret;
+		val->intval = (int)v8 * SC2021_IBUS_STEP_UA;
+		return 0;
+
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = sc2021_read_u8(sc, SC2021_REG_IBUS_ADC, &v8);
+		if (ret)
+			return ret;
+		val->intval = (int)v8 * SC2021_IBUS_STEP_UA;
+		return 0;
+
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = sc->fw_ver;
+		return 0;
+
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "Southchip";
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct power_supply_desc sc2021_psy_desc = {
+	.name = "sc2021-typec",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
+		     BIT(POWER_SUPPLY_USB_TYPE_C) |
+		     BIT(POWER_SUPPLY_USB_TYPE_PD),
+	.properties = sc2021_psy_props,
+	.num_properties = ARRAY_SIZE(sc2021_psy_props),
+	.get_property = sc2021_psy_get_property,
+};
+
+static int sc2021_probe(struct i2c_client *client)
+{
+	struct power_supply_config psy_cfg = {};
+	struct device *dev = &client->dev;
+	struct sc2021_device *sc;
+	u8 ver = 0;
+	int ret;
+
+	sc = devm_kzalloc(dev, sizeof(*sc), GFP_KERNEL);
+	if (!sc)
+		return -ENOMEM;
+
+	sc->dev = dev;
+	mutex_init(&sc->lock);
+	INIT_DELAYED_WORK(&sc->evt_work, sc2021_typec_evt_worker);
+	i2c_set_clientdata(client, sc);
+
+	ret = devm_regulator_get_enable_optional(dev, "vdd");
+	if (ret < 0 && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to enable vdd supply\n");
+
+	sc->regmap = devm_regmap_init_i2c(client, &sc2021_regmap_config);
+	if (IS_ERR(sc->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc->regmap),
+				     "failed to init regmap\n");
+
+	ret = sc2021_read_u8(sc, SC2021_REG_FW_VERSION, &ver);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read SC2021 version\n");
+
+	scnprintf(sc->fw_ver, sizeof(sc->fw_ver), "SC2021 V%u.%u",
+		  (ver >> 4) & 0xf, ver & 0xf);
+
+	sc->pdotg_gpio = devm_gpiod_get_optional(dev, "pdotg", GPIOD_OUT_LOW);
+	if (IS_ERR(sc->pdotg_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc->pdotg_gpio),
+				     "failed to get pdotg gpio\n");
+
+	sc->dpdm_gpio = devm_gpiod_get_optional(dev, "dpdm", GPIOD_OUT_LOW);
+	if (IS_ERR(sc->dpdm_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc->dpdm_gpio),
+				     "failed to get dpdm gpio\n");
+
+	psy_cfg.fwnode = of_fwnode_handle(dev->of_node);
+	psy_cfg.drv_data = sc;
+	sc->psy = devm_power_supply_register(dev, &sc2021_psy_desc, &psy_cfg);
+	if (IS_ERR(sc->psy))
+		return dev_err_probe(dev, PTR_ERR(sc->psy),
+				     "failed to register power supply\n");
+
+	if (client->irq > 0) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL,
+						sc2021_irq_handler,
+						IRQF_TRIGGER_RISING |
+						IRQF_TRIGGER_FALLING |
+						IRQF_ONESHOT,
+						"sc2021", sc);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to request irq %d\n",
+					     client->irq);
+	}
+
+	schedule_delayed_work(&sc->evt_work, 0);
+	dev_info(dev, "%s probed\n", sc->fw_ver);
+	return 0;
+}
+
+static void sc2021_remove(struct i2c_client *client)
+{
+	struct sc2021_device *sc = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&sc->evt_work);
+}
+
+static int sc2021_suspend(struct device *dev)
+{
+	struct sc2021_device *sc = dev_get_drvdata(dev);
+
+	cancel_delayed_work_sync(&sc->evt_work);
+	return 0;
+}
+
+static int sc2021_resume(struct device *dev)
+{
+	struct sc2021_device *sc = dev_get_drvdata(dev);
+
+	mutex_lock(&sc->lock);
+	sc->retries = 0;
+	sc->state_valid = false;
+	mutex_unlock(&sc->lock);
+
+	schedule_delayed_work(&sc->evt_work, msecs_to_jiffies(50));
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sc2021_pm_ops, sc2021_suspend, sc2021_resume);
+
+static const struct of_device_id sc2021_of_match[] = {
+	{ .compatible = "southchip,sc2021" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, sc2021_of_match);
+
+static const struct i2c_device_id sc2021_i2c_id[] = {
+	{ "sc2021", 0 },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, sc2021_i2c_id);
+
+static struct i2c_driver sc2021_driver = {
+	.driver = {
+		.name = "sc2021-charger",
+		.of_match_table = sc2021_of_match,
+		.pm = pm_sleep_ptr(&sc2021_pm_ops),
+	},
+	.probe = sc2021_probe,
+	.remove = sc2021_remove,
+	.id_table = sc2021_i2c_id,
+};
+module_i2c_driver(sc2021_driver);
+
+MODULE_AUTHOR("CloudBook Air Linux Port");
+MODULE_DESCRIPTION("Southchip SC2021 Type-C PD port controller driver");
+MODULE_LICENSE("GPL");
