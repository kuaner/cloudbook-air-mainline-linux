#!/bin/busybox sh
# Minimal initramfs for the ZTE CloudBook Air (RK3568B2), mainline 6.12.
#
# Resolves the root filesystem by ext4 volume label so one initramfs serves
# both the USB bring-up test (LABEL=ROOTFS) and the internal eMMC install
# (LABEL=EMMC_ROOTFS). The label is read straight from the ext4 superblock at
# offset 0x478 instead of relying on blkid/udev, which busybox does not ship.
#
# UART messages match the strings in mainline-6.12/TESTPLAN.md so the same
# evidence can be quoted during bring-up.
#
# 6.12 only. From 7.3 on the rootfs ships a Debian initramfs-tools initrd
# generated by scripts/rootfs-postprocess-debian13.sh, which parses
# root=LABEL= itself and adds e2fsck and a recovery shell.

export PATH=/bin:/sbin
/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     proc /proc 2>/dev/null
mount -t sysfs    sys  /sys  2>/dev/null
mount -t devtmpfs dev  /dev  2>/dev/null
mkdir -p /dev/pts /newroot
mount -t devpts devpts /dev/pts 2>/dev/null
[ -e /dev/null ] || mknod -m 666 /dev/null c 1 3 2>/dev/null

echo "CLOUDBOOK minimal initramfs entered"

# ext4 superblock starts at 0x400; s_volume_name is 16 bytes at offset 0x78.
ext4_label() {
    dd if="$1" bs=8 skip=143 count=2 2>/dev/null | tr -d '\000'
}

dev=""
found=""
tries=0
while [ "$tries" -lt 240 ]; do
    for candidate in /dev/mmcblk0p20 /dev/mmcblk0p* /dev/mmcblk1p* \
                     /dev/sd*[0-9] /dev/sd* /dev/vd*[0-9] /dev/vd* \
                     /dev/nvme*n*p* /dev/nvme*n*; do
        [ -b "$candidate" ] || continue
        label=$(ext4_label "$candidate")
        case "$label" in
        EMMC_ROOTFS|ROOTFS)
            dev=$candidate
            found=$label
            break
            ;;
        esac
    done
    [ -n "$dev" ] && break
    tries=$((tries + 1))
    sleep 0.5
done

if [ -z "$dev" ]; then
    echo "CLOUDBOOK ROOTFS not found after timeout"
    echo "CLOUDBOOK dropping to rescue shell"
    exec /bin/sh
fi

echo "CLOUDBOOK found $found at $dev"

if ! mount -t ext4 -o rw "$dev" /newroot; then
    echo "CLOUDBOOK failed to mount $dev"
    exec /bin/sh
fi
echo "CLOUDBOOK ROOTFS mounted"

# Diagnostic: if the rootfs mounted, persist early boot evidence on the rootfs
# itself. If the screen/network never comes up, the USB can be moved back to a
# host and /root/cloudbook-initramfs.log read without UART.
mkdir -p /newroot/root 2>/dev/null
{
    echo "CLOUDBOOK initramfs root mount diagnostic"
    echo "dev=$dev label=$found"
    echo "--- cmdline ---"
    cat /proc/cmdline 2>/dev/null
    echo "--- partitions ---"
    cat /proc/partitions 2>/dev/null
    echo "--- block devices ---"
    ls -l /dev/sd* /dev/mmcblk* 2>/dev/null
    echo "--- dmesg ---"
    dmesg 2>/dev/null
} > /newroot/root/cloudbook-initramfs.log 2>&1 || true

mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /dev  /newroot/dev  2>/dev/null
mount --move /proc /newroot/proc 2>/dev/null
mount --move /sys  /newroot/sys  2>/dev/null

if [ ! -x /newroot/sbin/init ]; then
    echo "CLOUDBOOK /sbin/init missing on $found"
    exec /bin/sh
fi

echo "CLOUDBOOK switching to /sbin/init"
exec switch_root /newroot /sbin/init