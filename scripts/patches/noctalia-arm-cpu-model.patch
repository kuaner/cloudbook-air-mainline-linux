+  std::string readCpuModelField(std::istream& input) {
+    std::string line;
+    while (std::getline(input, line)) {
+      const auto colonPos = line.find(':');
+      if (colonPos == std::string::npos) {
+        continue;
+      }
+      const auto key = StringUtils::trim(line.substr(0, colonPos));
+      if (key == "model name" || key == "Model name") {
+        const auto name = StringUtils::trim(line.substr(colonPos + 1));
+        if (!name.empty()) {
+          return name;
+        }
+      }
+    }
+    return {};
+  }
