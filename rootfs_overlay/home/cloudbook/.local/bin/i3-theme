#!/bin/sh
# Switch the i3 color palette between the official catppuccin/i3 flavors.
#
# i3 expands variables per file, so the palette cannot live in an included
# file. The block in the main config is rewritten in place, validated with
# `i3 -C`, and only then activated. A backup of the previous config stays at
# ~/.config/i3/config.bak.
#
#   i3-theme latte|frappe|macchiato|mocha
set -eu
name=${1:?usage: i3-theme latte|frappe|macchiato|mocha}
src="$HOME/.config/i3/themes/catppuccin-$name"
[ -f "$src" ] || { echo "unknown flavor: $name" >&2; exit 1; }
cfg="$HOME/.config/i3/config"
cp "$cfg" "$cfg.bak"

tmp=$(mktemp)
awk -v theme="$src" -v name="$name" '
  /^# Catppuccin .* for i3/ {
    print "# Catppuccin " name " for i3 (catppuccin/i3), MIT; see themes/LICENSE."
    while ((getline line < theme) > 0) print line
    close(theme)
    skip = 1
    next
  }
  skip && /^$/ { skip = 0; print; next }
  skip { next }
  { print }
' "$cfg" > "$tmp"

if i3 -C -c "$tmp" >/dev/null 2>&1; then
  mv "$tmp" "$cfg"
  chmod 644 "$cfg"
  # Keep polybar in the same flavour: regenerate its [colors] section from the
  # same theme file, then restart the bar so it picks the new values up.
  if [ -d "$HOME/.config/polybar" ]; then
    {
      echo "[colors]"
      sed -n 's/^set [$]\([a-z0-9]*\) #\([0-9a-fA-F]\{6\}\)$/\1 = #\2/p' "$src"
    } > "$HOME/.config/polybar/colors.ini"
  fi
  i3-msg reload >/dev/null 2>&1 || true
  polybar-msg cmd restart >/dev/null 2>&1 || true
  echo "i3 theme: $name"
else
  rm -f "$tmp"
  echo "config validation failed; previous config kept" >&2
  exit 1
fi