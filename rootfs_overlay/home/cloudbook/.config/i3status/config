general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "read_file Battery"
order += "read_file Power"
order += "tztime local"

wireless _first_ {
    format_up = "W: %essid %quality"
    format_down = "W: down (Win+N)"
}

read_file Battery {
    path = "/sys/class/power_supply/sbs-0-000b/capacity"
    format = "BAT %content%"
    format_bad = "Battery unavailable"
}

read_file Power {
    path = "/sys/class/power_supply/sbs-0-000b/status"
    format = "%content"
    format_bad = ""
}


tztime local {
    format = "%Y-%m-%d %H:%M"
}
