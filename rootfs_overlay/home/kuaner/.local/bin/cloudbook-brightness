#!/bin/sh
# Adjust the panel backlight and show an Archcraft-style OSD.
set -eu
case "${1:-}" in
    up)    brightnessctl -c backlight -d backlight set 5%+ >/dev/null ;;
    down)  brightnessctl -c backlight -d backlight set 5%- >/dev/null ;;
    set50) brightnessctl -c backlight -d backlight set 50%  >/dev/null ;;
    *)     echo "usage: $0 up|down|set50" >&2; exit 1 ;;
esac
pct=$(brightnessctl -c backlight -d backlight -m | awk -F, '{print $4}')
dunstify -a brightness -u low -t 1200 -i display-brightness-symbolic -h "int:value:${pct%\%}" -h string:x-dunst-stack-tag:brightness "亮度  ${pct:-?}"
