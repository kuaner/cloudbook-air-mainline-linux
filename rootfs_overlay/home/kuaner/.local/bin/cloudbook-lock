#!/bin/sh
set -eu

session=${XDG_SESSION_ID:?}
exec 9>"${XDG_RUNTIME_DIR:?}/cloudbook-lock"
flock -n 9 || exit 0

session_is_active() {
    [ "$(loginctl show-session "$session" --property=Active --value)" = yes ]
}

session_is_active || exit 0
light-locker-command --lock

# Light Locker switches VTs asynchronously. Keep the lock until the greeter
# takes over so another request cannot restart the pending authentication.
for attempt in $(seq 100); do
    session_is_active || exit 0
    sleep 0.1
done
printf '%s\n' 'LightDM did not switch to the lock screen.' >&2
exit 1
