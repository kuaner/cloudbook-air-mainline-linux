#!/bin/sh
set -eu

config="$HOME/.config/i3"
runtime="${XDG_RUNTIME_DIR:-$HOME/.cache}/cloudbook-i3"
mkdir -p "$runtime"

printf '%s\n' 'Xcursor.theme: Qogirr-Dark' 'Xcursor.size: 24' | xrdb -merge
xsetroot -cursor_name left_ptr
if [ -r "$HOME/Pictures/tokyo.png" ]; then
    feh --no-fehbg --bg-fill "$HOME/Pictures/tokyo.png"
fi

if ! pgrep -u "$(id -u)" -x xsettingsd >/dev/null; then
    xsettingsd -c "$config/xsettingsd" >"$runtime/xsettingsd.log" 2>&1 </dev/null &
fi
if ! pgrep -u "$(id -u)" -x picom >/dev/null; then
    picom --config "$config/picom.conf" >"$runtime/picom.log" 2>&1 </dev/null &
fi
if ! dunstctl reload "$HOME/.config/dunst/dunstrc" >/dev/null 2>&1; then
    dunst -config "$HOME/.config/dunst/dunstrc" >"$runtime/dunst.log" 2>&1 </dev/null &
fi
