#!/bin/sh
set -eu

dark_dialog() {
    ADW_DEBUG_COLOR_SCHEME=prefer-dark zenity "$@"
}

show_error() {
    dark_dialog --error --title='切换系统' --text="$1" --no-markup || :
}

if ! grep -qw 'androidboot.slot_suffix=_a' /proc/cmdline; then
    show_error '请从 CloudBook Air 的 Linux A 槽启动。'
    exit 1
fi

dark_dialog --question --title='重启到安卓' --text='将重启到原厂安卓。请先保存工作。' \
    --ok-label='重启到安卓' --cancel-label='取消' --default-cancel || exit 0

if error=$(pkexec --disable-internal-agent /usr/local/sbin/cloudbook-mark-boot-successful switch-to-android 2>&1); then
    exit 0
else
    status=$?
fi
[ "$status" -ne 126 ] || exit 0
show_error "${error:-无法取得切换系统所需的管理员权限。}"
exit "$status"
