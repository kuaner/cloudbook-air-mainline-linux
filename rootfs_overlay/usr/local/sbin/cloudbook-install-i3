#!/bin/sh
# Prepare the graphical rootfs offline. The i3 layout is in the home overlay.
set -eu
umask 022
login_user=${1:?login user required}
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y i3-wm i3lock xss-lock rofi \
    network-manager-applet lxpolkit pkexec zenity pcmanfm firefox-esr firefox-esr-l10n-zh-cn \
    fonts-noto-cjk fonts-noto-cjk-extra fonts-noto-color-emoji \
    fonts-wqy-zenhei fonts-wqy-microhei \
    locales fcitx5 fcitx5-chinese-addons \
    fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fcitx5-config-qt im-config \
    polybar fonts-font-awesome scrot brightnessctl \
    feh dunst picom xsettingsd fonts-jetbrains-mono xfce4-terminal \
    alsa-utils iproute2
update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper
runuser -u "$login_user" -- sh -c 'printf "[Desktop]\nSession=i3\nLanguage=zh_CN.UTF-8\n" > "$HOME/.dmrc"'
runuser -u "$login_user" -- im-config -n fcitx5
runuser -u "$login_user" -- sh -c 'gtk-update-icon-cache -f "$HOME/.local/share/icons/Luv-Folders-Dark"'
