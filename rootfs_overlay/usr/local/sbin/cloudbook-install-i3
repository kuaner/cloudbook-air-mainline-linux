#!/bin/sh
# Prepare the graphical 7.3 rootfs offline. The i3 layout is in the home overlay.
set -eu
umask 022
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y i3-wm i3status i3lock rofi xterm \
    network-manager-applet lxpolkit pcmanfm firefox-esr firefox-esr-l10n-zh-cn \
    fonts-noto-cjk fonts-noto-cjk-extra fonts-noto-color-emoji \
    fonts-wqy-zenhei fonts-wqy-microhei \
    locales fcitx5 fcitx5-chinese-addons \
    fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fcitx5-config-qt im-config \
    polybar fonts-font-awesome scrot brightnessctl \
    hsetroot dunst picom fonts-jetbrains-mono xfce4-terminal
sed -i 's/^# *zh_CN.UTF-8 UTF-8$/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
runuser -u cloudbook -- sh -c 'printf "[Desktop]\nSession=i3\nLanguage=zh_CN.UTF-8\n" > "$HOME/.dmrc"'
runuser -u cloudbook -- im-config -n fcitx5
