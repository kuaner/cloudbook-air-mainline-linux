#!/usr/bin/python3
"""Mark the active A/B slot as successfully booted, like Android's bootctl.

The Rockchip U-Boot clears a slot's priority when the previous boot did not
report success. Android reports it through bootctl; this is the Linux
counterpart: rewrite the 32-byte AvbABData record at offset 0x800 of the misc
partition (magic, version, two slot entries, reserved, big-endian CRC32).

The write only happens once per slot: a slot already marked successful with
tries_remaining == 0 is left untouched, so the partition is not rewritten on
every boot.
"""

import os
import struct
import sys
import zlib

MISC_PATHS = ("/dev/disk/by-partlabel/misc", "/dev/mmcblk0p6")
OFFSET = 0x800
SIZE = 32
BACKUP = "/var/lib/cloudbook/misc-ab.bak"


def find_misc():
    for path in MISC_PATHS:
        if os.path.exists(path):
            return path
    return None


def slot_index():
    """0 for slot A, 1 for slot B; U-Boot passes androidboot.slot_suffix."""
    try:
        cmdline = open("/proc/cmdline").read()
    except OSError:
        return 0
    for token in cmdline.split():
        if token.startswith("androidboot.slot_suffix="):
            return 1 if token.endswith("_b") else 0
    return 0


def main():
    path = find_misc()
    if path is None:
        print("misc partition not found", file=sys.stderr)
        return 1

    with open(path, "r+b", buffering=0) as misc:
        misc.seek(OFFSET)
        data = bytearray(misc.read(SIZE))
        if len(data) != SIZE or data[:4] != b"\x00AB0":
            print("unexpected AvbABData header in %s" % path, file=sys.stderr)
            return 1
        if struct.unpack(">I", data[28:32])[0] != zlib.crc32(data[:28]) & 0xFFFFFFFF:
            print("AvbABData checksum mismatch, refusing to write", file=sys.stderr)
            return 1

        idx = slot_index()
        base = 8 + idx * 4
        priority, tries, successful, corrupt = data[base:base + 4]
        if successful and tries == 0:
            return 0
        if priority == 0:
            priority = 15

        if not os.path.exists(BACKUP):
            os.makedirs(os.path.dirname(BACKUP), exist_ok=True)
            with open(BACKUP, "wb") as backup:
                backup.write(bytes(data))

        data[base:base + 4] = bytes([priority, 0, 1, corrupt])
        data[28:32] = struct.pack(">I", zlib.crc32(data[:28]) & 0xFFFFFFFF)
        misc.seek(OFFSET)
        misc.write(bytes(data))
        os.fsync(misc.fileno())
        misc.seek(OFFSET)
        readback = misc.read(SIZE)

    if readback != bytes(data):
        print("readback mismatch after writing %s" % path, file=sys.stderr)
        return 1
    print("slot %s marked successful" % ("B" if idx else "A"))
    return 0


if __name__ == "__main__":
    sys.exit(main())