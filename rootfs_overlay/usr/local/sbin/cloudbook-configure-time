#!/bin/sh
# Called in the target rootfs before packaging.
set -eu
umask 022
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y systemd-timesyncd tzdata ca-certificates
test -f /usr/share/zoneinfo/Asia/Shanghai
ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
if [ -f /etc/timezone ]; then printf '%s\n' Asia/Shanghai >/etc/timezone; fi
systemctl --root=/ enable systemd-timesyncd.service

# systemd uses the mtime of this file as an initial floor for a stale RTC.
touch /usr/lib/clock-epoch
mkdir -p /etc/systemd/timesyncd.conf.d
cat >/etc/systemd/timesyncd.conf.d/70-cloudbook.conf <<'EOF'
[Time]
NTP=
NTP=ntp.aliyun.com ntp1.aliyun.com ntp2.aliyun.com 0.debian.pool.ntp.org time.cloudflare.com
FallbackNTP=ntp.aliyun.com 0.debian.pool.ntp.org
EOF
